# Set these in the process environment. This file is not loaded automatically.
APP_MODE=mock
# Must remain false until the real 1C adapter and its idempotency are verified.
ONEC_WRITE_ENABLED=false
# Manual mock-only recovery check: disabled, create_lost_response or post_lost_response.
FAKE_ONEC_FAULT=disabled
TELEGRAM_BOT_TOKEN=
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric user IDs, never usernames. Empty means startup fails.
TELEGRAM_ALLOWED_USER_IDS=
# disabled: legacy strict text only; openai: natural text and voice. All requests require preview confirmation.
AI_MODE=disabled
OPENAI_API_KEY=
# auto selects an available, supported model for each task.
OPENAI_LLM_MODEL=auto
OPENAI_STT_MODEL=auto

# FirstBit preview: switch APP_MODE to firstbit_readonly after filling these fields.
# Keep ONEC_WRITE_ENABLED=false and FAKE_ONEC_FAULT=disabled.
# HTTPS Standard OData root; must end in /odata/standard.odata/ (including trailing /).
FIRSTBIT_BASE_URL=
FIRSTBIT_USERNAME=
FIRSTBIT_PASSWORD=
# Set true only after the owner verifies this dedicated account has read-only rights.
FIRSTBIT_READONLY_ACCOUNT=false
# Verified non-zero Ref_Key of the bookkeeping Service item, not an Item code/name.
FIRSTBIT_BOOKKEEPING_ITEM_ID=
# Optional reviewed aliases: JSON object from user spelling to Company Ref_Key.
FIRSTBIT_CLIENT_ALIASES={}
# Only for scripts/firstbit_readonly_smoke.py --live; never sent to OpenAI/Telegram.
FIRSTBIT_SMOKE_CLIENT=
FIRSTBIT_SMOKE_INVOICE_DATE=
