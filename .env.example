# Set these in the process environment. This file is not loaded automatically.
APP_MODE=mock
# False for mock/firstbit_readonly. Controlled creation admission is documented
# in docs/firstbit/PRODUCTION_OPERATION.md; native finalization is a separate opt-in.
ONEC_WRITE_ENABLED=false
# Manual mock-only recovery check: disabled, create_lost_response or post_lost_response.
FAKE_ONEC_FAULT=disabled
TELEGRAM_BOT_TOKEN=
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric user IDs, never usernames. Empty means startup fails.
TELEGRAM_ALLOWED_USER_IDS=
# disabled: legacy strict text only; openai: natural text and voice. All requests require preview confirmation.
AI_MODE=disabled
OPENAI_API_KEY=
# auto selects an available, supported model for each task.
OPENAI_LLM_MODEL=auto
OPENAI_STT_MODEL=auto

# FirstBit preview: switch APP_MODE to firstbit_readonly after filling these fields.
# Keep ONEC_WRITE_ENABLED=false and FAKE_ONEC_FAULT=disabled.
# HTTPS Standard OData root; must end in /odata/standard.odata/ (including trailing /).
FIRSTBIT_BASE_URL=
FIRSTBIT_USERNAME=
FIRSTBIT_PASSWORD=
# Set true only after the owner verifies this dedicated account has read-only rights.
FIRSTBIT_READONLY_ACCOUNT=false
# Verified non-zero Ref_Key of the bookkeeping Service item, not an Item code/name.
FIRSTBIT_BOOKKEEPING_ITEM_ID=
# Optional reviewed aliases: JSON object from user spelling to Company Ref_Key.
FIRSTBIT_CLIENT_ALIASES={}
# Only for scripts/firstbit_readonly_smoke.py --live; never sent to OpenAI/Telegram.
FIRSTBIT_SMOKE_CLIENT=
FIRSTBIT_SMOKE_INVOICE_DATE=
# Optional ngrok agent credential; use ENV/private .env.local only, never CLI args.
# Existing user-owned ngrok config can supply it locally without being modified.
NGROK_AUTHTOKEN=
# Optional durable confirmed-operation/PDF-delivery journal. Absolute private
# path; on Linux parent 0700/file 0600. Unconfirmed drafts/receipts remain local.
# This does not enable FirstBit writes or make FakeOneC documents durable.
INVOICE_OPERATION_DB=
# Financial production proof and supported scope: docs/firstbit/PRODUCTION_OPERATION.md.
# Controlled create: APP_MODE=firstbit_write, ONEC_WRITE_ENABLED=true, existing
# private journal required. The base writer creates only a draft.
# Owner-attested dedicated integration identity with create/read rights, never admin.
FIRSTBIT_INTEGRATION_ACCOUNT=false
# Separately reviewed execution_schema (base) or full_execution_schema (native) pin.
# Never accept drift automatically.
FIRSTBIT_WRITE_SCHEMA_SHA256=

# Optional VPS-native posting / Generate Tax Invoice / native landscape PDF.
# Requires firstbit_write, explicit write flag, native schema pin and dedicated browser runtime.
FIRSTBIT_NATIVE_UI_ENABLED=false
